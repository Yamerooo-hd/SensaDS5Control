<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SensaDS5Control.App.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Border.card">
      <Setter Property="Background" Value="#161B26" />
      <Setter Property="BorderBrush" Value="#252C3D" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="16" />
    </Style>
    <Style Selector="Border.pill">
      <Setter Property="Background" Value="#1F2636" />
      <Setter Property="BorderBrush" Value="#2E374D" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="Padding" Value="10,4" />
    </Style>
    <Style Selector="TextBlock.hdr">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#F3F6FC" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style Selector="TextBlock.title">
      <Setter Property="FontSize" Value="21" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="#F8FAFC" />
    </Style>
    <Style Selector="TextBlock.dim">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="#94A3B8" />
    </Style>
    <Style Selector="Button.nav">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#94A3B8" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="Medium" />
    </Style>
    <Style Selector="Button.nav:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#1C2333" />
      <Setter Property="Foreground" Value="#E2E8F0" />
    </Style>
    <Style Selector="Button.nav.active">
      <Setter Property="Background" Value="#1E293B" />
      <Setter Property="Foreground" Value="#38BDF8" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.accent">
      <Setter Property="Background" Value="#2563EB" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.danger">
      <Setter Property="Background" Value="#7F1D1D" />
      <Setter Property="Foreground" Value="#FECACA" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
  </Application.Styles>
</Application>
