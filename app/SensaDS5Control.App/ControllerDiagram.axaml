<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SensaDS5Control.App.ControllerDiagram">
  <Viewbox Stretch="Uniform" MaxHeight="315">
    <Grid Width="480" Height="300">
      <!-- ==================== DUALSENSE / COSMIC BYTE SENSA LAYER ==================== -->
      <Canvas x:Name="Ds5Layer" Width="480" Height="300" IsVisible="True">
        <!-- L2 / R2 Analog Pressure Badges -->
        <Border Canvas.Left="76" Canvas.Top="6" Width="76" Height="20"
                CornerRadius="6" Background="#131926" BorderBrush="#2D384F" BorderThickness="1">
          <Grid>
            <Border x:Name="L2Fill" HorizontalAlignment="Left" Width="0" Background="#38BDF8" CornerRadius="5" Opacity="0.72" />
            <TextBlock x:Name="L2Lbl" Text="L2  --" FontSize="10" FontWeight="SemiBold"
                       Foreground="#E2E8F0" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Grid>
        </Border>
        <Border Canvas.Left="328" Canvas.Top="6" Width="76" Height="20"
                CornerRadius="6" Background="#131926" BorderBrush="#2D384F" BorderThickness="1">
          <Grid>
            <Border x:Name="R2Fill" HorizontalAlignment="Left" Width="0" Background="#38BDF8" CornerRadius="5" Opacity="0.72" />
            <TextBlock x:Name="R2Lbl" Text="R2  --" FontSize="10" FontWeight="SemiBold"
                       Foreground="#E2E8F0" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Grid>
        </Border>

        <!-- L1 / R1 Sculpted DualSense Shoulder Bumpers -->
        <Border x:Name="BtnL1" Canvas.Left="78" Canvas.Top="31" Width="72" Height="16"
                CornerRadius="12,12,3,3" Background="#232B3D" BorderBrush="#394560" BorderThickness="1.2">
          <TextBlock Text="L1" FontSize="9" FontWeight="Bold" Foreground="#CBD5E1" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <Border x:Name="BtnR1" Canvas.Left="330" Canvas.Top="31" Width="72" Height="16"
                CornerRadius="12,12,3,3" Background="#232B3D" BorderBrush="#394560" BorderThickness="1.2">
          <TextBlock Text="R1" FontSize="9" FontWeight="Bold" Foreground="#CBD5E1" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>

        <!-- DualSense Outer Two-Tone Wing Silhouette (Long tapered horns + flared palm shoulders) -->
        <Path Fill="#242C3D" Stroke="#3B4762" StrokeThickness="2"
              Data="M 134,44 C 92,44 62,64 47,108 L 19,212 C 11,244 26,272 54,274 C 77,276 96,256 122,202 L 154,188 L 326,188 L 358,202 C 384,256 403,276 426,274 C 454,272 469,244 461,212 L 433,108 C 418,64 388,44 346,44 Z" />

        <!-- Signature DualSense Inner Lower Dark U-Frame Collar (houses both sticks + PS + Mic) -->
        <Path Fill="#111622" Stroke="#2A344B" StrokeThickness="1.4"
              Data="M 152,126 C 134,132 126,154 130,180 C 134,196 144,200 156,192 L 324,192 C 336,200 346,196 350,180 C 354,154 346,132 328,126 Z" />

        <!-- Subtle DualSense Handle Seam Accents -->
        <Path Stroke="#141A26" StrokeThickness="2"
              Data="M 134,138 C 115,180 86,246 58,268" />
        <Path Stroke="#141A26" StrokeThickness="2"
              Data="M 346,138 C 365,180 394,246 422,268" />

        <!-- Trapezoidal Floating DualSense Touchpad -->
        <Path x:Name="Ds5TouchpadShape" Fill="#161C29" Stroke="#2B354B" StrokeThickness="1.3"
              Data="M 162,46 L 318,46 C 321,46 322,49 321,54 L 308,116 C 306,122 301,125 294,125 L 186,125 C 179,125 174,122 172,116 L 159,54 C 158,49 159,46 162,46 Z" />

        <!-- Signature Angled DualSense V-Lightbar Glow Strips Framing Touchpad -->
        <Path x:Name="Ds5LightbarGlow" Stroke="#00A0FF" StrokeThickness="3.2" StrokeLineCap="Round"
              Data="M 157,50 L 170,117 C 172,124 178,128 186,128 L 294,128 C 302,128 308,124 310,117 L 323,50" />

        <!-- Touchpad Coordinate Canvas -->
        <Canvas Canvas.Left="168" Canvas.Top="48" Width="144" Height="74">
          <TextBlock Text="TOUCHPAD" FontSize="8" LetterSpacing="1.5" Foreground="#3B4762" Canvas.Left="41" Canvas.Top="31" />
          <Ellipse x:Name="TpDot0" Width="11" Height="11" Fill="#22C55E" IsVisible="False" />
          <Ellipse x:Name="TpDot1" Width="11" Height="11" Fill="#F59E0B" IsVisible="False" />
        </Canvas>

        <!-- Slanted Create & Options Capsules (DualSense style) -->
        <Border x:Name="BtnCreate" Canvas.Left="140" Canvas.Top="61" Width="10" Height="22"
                CornerRadius="5" Background="#2B3449" BorderBrush="#445273" BorderThickness="1">
          <Border.RenderTransform>
            <RotateTransform Angle="-11" />
          </Border.RenderTransform>
        </Border>
        <Border x:Name="BtnOptions" Canvas.Left="330" Canvas.Top="61" Width="10" Height="22"
                CornerRadius="5" Background="#2B3449" BorderBrush="#445273" BorderThickness="1">
          <Border.RenderTransform>
            <RotateTransform Angle="11" />
          </Border.RenderTransform>
        </Border>

        <!-- DualSense Recessed D-Pad (Left) -->
        <Ellipse Canvas.Left="62" Canvas.Top="74" Width="78" Height="78" Fill="#1B2232" Stroke="#2E3850" StrokeThickness="1" />
        <Border x:Name="DpadUp" Canvas.Left="91" Canvas.Top="80" Width="20" Height="23" CornerRadius="4,4,8,8" Background="#2C364D">
          <TextBlock Text="▲" FontSize="8" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <Border x:Name="DpadDown" Canvas.Left="91" Canvas.Top="123" Width="20" Height="23" CornerRadius="8,8,4,4" Background="#2C364D">
          <TextBlock Text="▼" FontSize="8" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <Border x:Name="DpadLeft" Canvas.Left="68" Canvas.Top="103" Width="23" Height="20" CornerRadius="4,8,8,4" Background="#2C364D">
          <TextBlock Text="◀" FontSize="8" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <Border x:Name="DpadRight" Canvas.Left="111" Canvas.Top="103" Width="23" Height="20" CornerRadius="8,4,4,8" Background="#2C364D">
          <TextBlock Text="▶" FontSize="8" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <Ellipse Canvas.Left="94" Canvas.Top="106" Width="14" Height="14" Fill="#1B2232" />

        <!-- DualSense Geometric Face Buttons (Right) -->
        <Ellipse Canvas.Left="340" Canvas.Top="74" Width="78" Height="78" Fill="#1B2232" Stroke="#2E3850" StrokeThickness="1" />
        <Border x:Name="BtnTriangle" Canvas.Left="368" Canvas.Top="78" Width="22" Height="22" CornerRadius="11"
                Background="#242C3D" BorderBrush="#4ADE80" BorderThickness="1.3">
          <TextBlock Text="△" FontSize="11" Foreground="#4ADE80" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <Border x:Name="BtnCircle" Canvas.Left="392" Canvas.Top="102" Width="22" Height="22" CornerRadius="11"
                Background="#242C3D" BorderBrush="#F87171" BorderThickness="1.3">
          <TextBlock Text="○" FontSize="12" Foreground="#F87171" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <Border x:Name="BtnCross" Canvas.Left="368" Canvas.Top="126" Width="22" Height="22" CornerRadius="11"
                Background="#242C3D" BorderBrush="#60A5FA" BorderThickness="1.3">
          <TextBlock Text="✕" FontSize="11" Foreground="#60A5FA" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <Border x:Name="BtnSquare" Canvas.Left="344" Canvas.Top="102" Width="22" Height="22" CornerRadius="11"
                Background="#242C3D" BorderBrush="#F472B6" BorderThickness="1.3">
          <TextBlock Text="□" FontSize="11" Foreground="#F472B6" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>

        <!-- Dual Symmetrical Thumbsticks (Mounted in Black Collar) -->
        <Ellipse x:Name="LeftStickRing" Canvas.Left="142" Canvas.Top="136" Width="56" Height="56"
                 Fill="#0B0F18" Stroke="#303B54" StrokeThickness="2" />
        <Ellipse x:Name="LeftStickDome" Canvas.Left="154" Canvas.Top="148" Width="32" Height="32"
                 Fill="#2B354B" Stroke="#536385" StrokeThickness="1.5" />

        <Ellipse x:Name="RightStickRing" Canvas.Left="282" Canvas.Top="136" Width="56" Height="56"
                 Fill="#0B0F18" Stroke="#303B54" StrokeThickness="2" />
        <Ellipse x:Name="RightStickDome" Canvas.Left="294" Canvas.Top="148" Width="32" Height="32"
                 Fill="#2B354B" Stroke="#536385" StrokeThickness="1.5" />

        <!-- Center Speaker Slots, PS Emblem, Mic Mute & Orange LED -->
        <Border Canvas.Left="222" Canvas.Top="136" Width="36" Height="3" CornerRadius="1.5" Background="#252E42" />
        <Border x:Name="BtnPs" Canvas.Left="228" Canvas.Top="146" Width="24" Height="22" CornerRadius="11"
                Background="#232B3E" BorderBrush="#475569" BorderThickness="1.2">
          <TextBlock Text="PS" FontSize="8" FontWeight="Bold" Foreground="#CBD5E1" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <Border x:Name="BtnMic" Canvas.Left="231" Canvas.Top="174" Width="18" Height="6" CornerRadius="3"
                Background="#2B354A" />
        <Border x:Name="MicLedStrip" Canvas.Left="233" Canvas.Top="183" Width="14" Height="3" CornerRadius="1.5"
                Background="#334155" />
      </Canvas>

      <!-- ==================== XBOX 360 / XINPUT LAYER ==================== -->
      <Canvas x:Name="XboxLayer" Width="480" Height="300" IsVisible="False">
        <!-- LT / RT Trigger Pressure Gauges -->
        <Border Canvas.Left="84" Canvas.Top="6" Width="78" Height="20"
                CornerRadius="6" Background="#131D16" BorderBrush="#2A4232" BorderThickness="1">
          <Grid>
            <Border x:Name="LtFill" HorizontalAlignment="Left" Width="0" Background="#22C55E" CornerRadius="5" Opacity="0.72" />
            <TextBlock x:Name="LtLbl" Text="LT  --" FontSize="10" FontWeight="SemiBold"
                       Foreground="#E2E8F0" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Grid>
        </Border>
        <Border Canvas.Left="318" Canvas.Top="6" Width="78" Height="20"
                CornerRadius="6" Background="#131D16" BorderBrush="#2A4232" BorderThickness="1">
          <Grid>
            <Border x:Name="RtFill" HorizontalAlignment="Left" Width="0" Background="#22C55E" CornerRadius="5" Opacity="0.72" />
            <TextBlock x:Name="RtLbl" Text="RT  --" FontSize="10" FontWeight="SemiBold"
                       Foreground="#E2E8F0" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Grid>
        </Border>

        <!-- LB / RB Wide Wrap Bumpers -->
        <Border x:Name="BtnLb" Canvas.Left="76" Canvas.Top="31" Width="86" Height="17"
                CornerRadius="14,6,3,3" Background="#222C26" BorderBrush="#394B40" BorderThickness="1.2">
          <TextBlock Text="LB" FontSize="9" FontWeight="Bold" Foreground="#CBD5E1" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <Border x:Name="BtnRb" Canvas.Left="318" Canvas.Top="31" Width="86" Height="17"
                CornerRadius="6,14,3,3" Background="#222C26" BorderBrush="#394B40" BorderThickness="1.2">
          <TextBlock Text="RB" FontSize="9" FontWeight="Bold" Foreground="#CBD5E1" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>

        <!-- Xbox Sculpted Ergonomic Body Silhouette -->
        <Path Fill="#1E2622" Stroke="#35463D" StrokeThickness="2"
              Data="M 124,44 C 84,44 54,68 42,116 L 24,206 C 19,244 38,274 72,272 C 98,270 116,242 138,210 C 166,198 314,198 342,210 C 364,242 382,270 408,272 C 442,274 461,244 456,206 L 438,116 C 426,68 396,44 356,44 C 314,44 294,40 240,40 C 186,40 166,44 124,44 Z" />

        <!-- Xbox Subtle Battery / Center Crest Accent -->
        <Path Fill="#161D19" Stroke="#2A3830" StrokeThickness="1.2"
              Data="M 186,46 C 210,41 270,41 294,46 L 284,82 C 266,94 214,94 196,82 Z" />

        <!-- Xbox Illuminated Guide Sphere -->
        <Border x:Name="BtnXboxGuide" Canvas.Left="222" Canvas.Top="50" Width="36" Height="36" CornerRadius="18"
                Background="#1A2620" BorderBrush="#22C55E" BorderThickness="2">
          <TextBlock Text="X" FontSize="15" FontWeight="Black" Foreground="#4ADE80"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>

        <!-- View (Back) & Menu (Start) Buttons -->
        <Border x:Name="BtnXboxBack" Canvas.Left="180" Canvas.Top="100" Width="22" Height="22" CornerRadius="11"
                Background="#232D27" BorderBrush="#415248" BorderThickness="1.1">
          <TextBlock Text="⧉" FontSize="10" Foreground="#CBD5E1" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <Border x:Name="BtnXboxStart" Canvas.Left="278" Canvas.Top="100" Width="22" Height="22" CornerRadius="11"
                Background="#232D27" BorderBrush="#415248" BorderThickness="1.1">
          <TextBlock Text="≡" FontSize="12" Foreground="#CBD5E1" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>

        <!-- Asymmetric Top-Left Analog Stick (LS) -->
        <Ellipse x:Name="XbxLsRing" Canvas.Left="86" Canvas.Top="78" Width="58" Height="58"
                 Fill="#0E1310" Stroke="#33423A" StrokeThickness="2" />
        <Ellipse x:Name="XbxLsDome" Canvas.Left="99" Canvas.Top="91" Width="32" Height="32"
                 Fill="#29342E" Stroke="#51665A" StrokeThickness="1.5" />

        <!-- Lower-Left-Center Faceted D-Pad -->
        <Ellipse Canvas.Left="134" Canvas.Top="142" Width="68" Height="68" Fill="#141B17" Stroke="#2A3830" StrokeThickness="1" />
        <Border x:Name="XbxDpadUp" Canvas.Left="159" Canvas.Top="147" Width="18" Height="21" CornerRadius="4" Background="#29342E" />
        <Border x:Name="XbxDpadDown" Canvas.Left="159" Canvas.Top="184" Width="18" Height="21" CornerRadius="4" Background="#29342E" />
        <Border x:Name="XbxDpadLeft" Canvas.Left="140" Canvas.Top="167" Width="21" Height="18" CornerRadius="4" Background="#29342E" />
        <Border x:Name="XbxDpadRight" Canvas.Left="175" Canvas.Top="167" Width="21" Height="18" CornerRadius="4" Background="#29342E" />
        <Ellipse Canvas.Left="160" Canvas.Top="168" Width="16" Height="16" Fill="#222B26" />

        <!-- Top-Right ABXY Convex Colored Jewel Buttons -->
        <Border x:Name="BtnXboxY" Canvas.Left="355" Canvas.Top="72" Width="24" Height="24" CornerRadius="12"
                Background="#262D24" BorderBrush="#FACC15" BorderThickness="1.5">
          <TextBlock Text="Y" FontSize="11" FontWeight="Bold" Foreground="#FACC15" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <Border x:Name="BtnXboxB" Canvas.Left="381" Canvas.Top="96" Width="24" Height="24" CornerRadius="12"
                Background="#2D2224" BorderBrush="#EF4444" BorderThickness="1.5">
          <TextBlock Text="B" FontSize="11" FontWeight="Bold" Foreground="#EF4444" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <Border x:Name="BtnXboxA" Canvas.Left="355" Canvas.Top="120" Width="24" Height="24" CornerRadius="12"
                Background="#1E2D24" BorderBrush="#22C55E" BorderThickness="1.5">
          <TextBlock Text="A" FontSize="11" FontWeight="Bold" Foreground="#22C55E" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <Border x:Name="BtnXboxX" Canvas.Left="329" Canvas.Top="96" Width="24" Height="24" CornerRadius="12"
                Background="#1E2733" BorderBrush="#3B82F6" BorderThickness="1.5">
          <TextBlock Text="X" FontSize="11" FontWeight="Bold" Foreground="#60A5FA" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>

        <!-- Lower-Right-Center Analog Stick (RS) -->
        <Ellipse x:Name="XbxRsRing" Canvas.Left="280" Canvas.Top="145" Width="58" Height="58"
                 Fill="#0E1310" Stroke="#33423A" StrokeThickness="2" />
        <Ellipse x:Name="XbxRsDome" Canvas.Left="293" Canvas.Top="158" Width="32" Height="32"
                 Fill="#29342E" Stroke="#51665A" StrokeThickness="1.5" />
      </Canvas>
    </Grid>
  </Viewbox>
</UserControl>
