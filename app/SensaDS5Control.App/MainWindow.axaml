<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SensaDS5Control.App"
        x:Class="SensaDS5Control.App.MainWindow"
        Title="SensaDS5Control — Cosmic Byte Sensa Wireless Suite"
        Width="1120" Height="730" MinWidth="920" MinHeight="620"
        Background="#0B0E14">

  <Grid ColumnDefinitions="255,*">
    <!-- LEFT SIDEBAR -->
    <Border Grid.Column="0" Background="#121620" BorderBrush="#212838" BorderThickness="0,0,1,0" Padding="14">
      <DockPanel>
        <!-- Brand Header -->
        <StackPanel DockPanel.Dock="Top" Spacing="12">
          <StackPanel Orientation="Horizontal" Spacing="10" Margin="2,4,2,2">
            <Border Width="38" Height="38" CornerRadius="10" Background="#1D2B48" BorderBrush="#3B82F6" BorderThickness="1">
              <PathIcon Width="20" Height="20" Foreground="#60A5FA"
                        Data="M 6,6 C 3.5,6 2,8.5 1.5,12 L 0.5,18 C 0.3,20.2 1.8,21.5 3.4,21.5 C 4.8,21.5 6,19.8 7,17 L 9.5,15.5 L 14.5,15.5 L 17,17 C 18,19.8 19.2,21.5 20.6,21.5 C 22.2,21.5 23.7,20.2 23.5,18 L 22.5,12 C 22,8.5 20.5,6 18,6 Z" />
            </Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="SensaDS5Control" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC" />
              <TextBlock Text="Pico 2 W Wireless Bridge" FontSize="11" Foreground="#64748B" />
            </StackPanel>
          </StackPanel>

          <!-- Auto-Connect Status Card -->
          <Border Background="#171C28" BorderBrush="#262E42" BorderThickness="1" CornerRadius="10" Padding="12">
            <StackPanel Spacing="8">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="#64748B" VerticalAlignment="Center" />
                <TextBlock x:Name="StatusText" Text="Searching for Pico..." FontWeight="SemiBold" FontSize="13" Foreground="#F1F5F9" />
              </StackPanel>
              <TextBlock x:Name="SubStatusText" Classes="dim" Text="Plug Pico 2 W into USB (Auto-Connect)" TextWrapping="Wrap" />
              <WrapPanel Orientation="Horizontal">
                <Border Classes="pill" Margin="0,0,6,4">
                  <TextBlock x:Name="PortBadgeTxt" Text="USB: --" FontSize="11" Foreground="#CBD5E1" />
                </Border>
                <Border Classes="pill" Margin="0,0,0,4">
                  <TextBlock x:Name="BatteryBadgeTxt" Text="Bat: --" FontSize="11" Foreground="#94A3B8" />
                </Border>
              </WrapPanel>
              <Button x:Name="ConnectBtn" Content="Connect" Click="OnConnectClick"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Classes="accent" />
            </StackPanel>
          </Border>

          <!-- Navigation Rail -->
          <TextBlock Text="WORKSPACE" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="6,4,0,0" />
          <StackPanel Spacing="4">
            <Button x:Name="NavDashBtn" Classes="nav active" Click="OnNavClick" Tag="0">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <PathIcon Width="16" Height="16" Data="M 3,13 L 11,13 L 11,3 L 3,3 Z M 3,21 L 11,21 L 11,15 L 3,15 Z M 13,21 L 21,21 L 21,11 L 13,11 Z M 13,3 L 13,9 L 21,9 L 21,3 Z" />
                <TextBlock Text="Dashboard" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button x:Name="NavTesterBtn" Classes="nav" Click="OnNavClick" Tag="1">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <PathIcon Width="16" Height="16" Data="M 6,6 C 3.5,6 2,8.5 1.5,12 L 0.5,18 C 0.3,20.2 1.8,21.5 3.4,21.5 C 4.8,21.5 6,19.8 7,17 L 9.5,15.5 L 14.5,15.5 L 17,17 C 18,19.8 19.2,21.5 20.6,21.5 C 22.2,21.5 23.7,20.2 23.5,18 L 22.5,12 C 22,8.5 20.5,6 18,6 Z" />
                <TextBlock Text="Controller Tester" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button x:Name="NavHapticsBtn" Classes="nav" Click="OnNavClick" Tag="2">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <PathIcon Width="16" Height="16" Data="M 7,18 L 9,18 L 9,6 L 7,6 Z M 11,22 L 13,22 L 13,2 L 11,2 Z M 3,14 L 5,14 L 5,10 L 3,10 Z M 15,18 L 17,18 L 17,6 L 15,6 Z M 19,14 L 21,14 L 21,10 L 19,10 Z" />
                <TextBlock Text="Haptics &amp; Rumble" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button x:Name="NavTriggersBtn" Classes="nav" Click="OnNavClick" Tag="3">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <PathIcon Width="16" Height="16" Data="M 13,2 L 3,14 L 12,14 L 11,22 L 21,10 L 12,10 Z" />
                <TextBlock Text="Adaptive Triggers" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button x:Name="NavLightingBtn" Classes="nav" Click="OnNavClick" Tag="4">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <PathIcon Width="16" Height="16" Data="M 12,2 A 7,7 0 0 0 7,14 L 8,17 L 16,17 L 17,14 A 7,7 0 0 0 12,2 Z M 9,20 L 15,20 L 15,22 L 9,22 Z" />
                <TextBlock Text="Lighting &amp; Mic" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button x:Name="NavConsoleBtn" Classes="nav" Click="OnNavClick" Tag="5">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <PathIcon Width="16" Height="16" Data="M 4,4 L 20,4 A 2,2 0 0 1 22,6 L 22,18 A 2,2 0 0 1 20,20 L 4,20 A 2,2 0 0 1 2,18 L 2,6 A 2,2 0 0 1 4,4 Z M 6,9 L 10,12 L 6,15 M 12,15 L 18,15" />
                <TextBlock Text="Console &amp; Updates" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>
        </StackPanel>

        <!-- Sidebar Bottom Quick Controls -->
        <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom" Spacing="6" Margin="0,12,0,0">
          <ToggleButton x:Name="QuickTouchMouseBtn" Content="Touchpad Mouse: OFF"
                        Click="OnQuickTouchMouseClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
          <Button x:Name="QuickMicMuteBtn" Content="Mic: Unmuted"
                  Click="OnToggleMicMuteClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
          <Button x:Name="QuickUpdateBtn" Content="Update FW / App" Click="OnUpdateFirmwareClick"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="#166534" Foreground="White" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- MAIN CONTENT WORKSPACE -->
    <Grid Grid.Column="1" Margin="20,16">
      <!-- PAGE 0: DASHBOARD -->
      <ScrollViewer x:Name="Page0" IsVisible="True">
        <StackPanel Spacing="14">
          <StackPanel Spacing="2">
            <TextBlock Classes="title" Text="Overview &amp; USB Identity" />
            <TextBlock Classes="dim" Text="Automatic USB hotplug bridge, mouse mapping, DualSense / Xbox 360 mode switcher &amp; Impulse Triggers." />
          </StackPanel>

          <!-- Hero Card: Live Controller Preview + Bridge Summary -->
          <Border Classes="card">
            <Grid ColumnDefinitions="1.15*,*">
              <local:ControllerDiagram x:Name="DashControllerDiagram" MaxHeight="225" Margin="0,0,14,0" />
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="10">
                <TextBlock Classes="hdr" Text="Live Bridge Telemetry" />
                <TextBlock x:Name="DashBridgeInfo" Text="Bridge: Searching for Pico USB..." FontSize="13" />
                <TextBlock x:Name="DashBatteryInfo" Text="Battery: --" FontSize="13" />
                <TextBlock x:Name="DashReportMode" Text="Input Mode: --" FontSize="13" />
                <TextBlock Classes="dim" Text="0x36 Audio-Haptics stream automatically when DualSense games play 4-ch sound." TextWrapping="Wrap" />
              </StackPanel>
            </Grid>
          </Border>

          <Grid ColumnDefinitions="*,*">
            <!-- Mouse & Gyro Card -->
            <Border Classes="card" Margin="0,0,7,0">
              <StackPanel Spacing="8">
                <TextBlock Classes="hdr" Text="Touchpad &amp; Gyro Mouse" />
                <CheckBox x:Name="TouchMouseChk" Content="Touchpad as Mouse (1-finger move, tap click, 2-finger scroll)"
                          IsCheckedChanged="OnMouseSettingsChanged" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="Touch Sens:" VerticalAlignment="Center" Width="85" />
                  <Slider x:Name="TouchSensSlider" Minimum="0.3" Maximum="3.5" Value="1.2" Width="170"
                          ValueChanged="OnMouseSettingsChanged" />
                  <TextBlock x:Name="TouchSensLabel" Text="1.2x" VerticalAlignment="Center" />
                </StackPanel>
                <CheckBox x:Name="GyroMouseChk" Content="Gyro Aiming as Mouse" IsCheckedChanged="OnMouseSettingsChanged" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <CheckBox x:Name="GyroL2Chk" Content="Only while holding L2" IsChecked="True" IsCheckedChanged="OnMouseSettingsChanged" />
                  <Button Content="Calibrate Zero" Click="OnCalibrateGyroClick" />
                </StackPanel>
              </StackPanel>
            </Border>

            <!-- USB Mode + Impulse Triggers Card -->
            <Border Grid.Column="1" Classes="card" Margin="7,0,0,0">
              <StackPanel Spacing="8">
                <TextBlock Classes="hdr" Text="USB Mode &amp; Xbox 360 Impulse Triggers" />
                <WrapPanel Orientation="Horizontal">
                  <Button x:Name="BtnUsbDs5" Content="DualSense (054C:0CE6)" Click="OnUsbModeDs5Click" Margin="0,0,8,6" />
                  <Button x:Name="BtnUsbX360" Content="Xbox 360 XInput (1209:DB05)" Click="OnUsbModeX360Click" Margin="0,0,0,6" />
                </WrapPanel>
                <TextBlock x:Name="UsbModeStatus" Classes="dim" Text="Active USB Personality: DualSense Wireless Controller (054C:0CE6)" />
                <Border Height="1" Background="#242B3D" Margin="0,2" />
                <TextBlock Text="Impulse Triggers (Rumble → L2 / R2 0x26)" FontWeight="SemiBold" FontSize="13" />
                <ComboBox x:Name="ImpulseModeCombo" HorizontalAlignment="Stretch" SelectionChanged="OnImpulseModeChanged" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="Strength:" VerticalAlignment="Center" Width="62" />
                  <Slider x:Name="ImpulseStrengthSlider" Minimum="0" Maximum="100" Value="85" Width="140"
                          ValueChanged="OnImpulseStrengthChanged" />
                  <TextBlock x:Name="ImpulseStrengthLabel" Text="85%" VerticalAlignment="Center" Width="40" FontWeight="SemiBold" />
                  <Button Content="Test Triggers" Click="OnTestImpulseTriggersClick" />
                </StackPanel>
              </StackPanel>
            </Border>
          </Grid>
        </StackPanel>
      </ScrollViewer>

      <!-- PAGE 1: CONTROLLER TESTER -->
      <ScrollViewer x:Name="Page1" IsVisible="False">
        <StackPanel Spacing="14">
          <StackPanel Spacing="2">
            <TextBlock Classes="title" Text="Interactive Controller Tester" />
            <TextBlock Classes="dim" Text="Every button, bumper, analog trigger, thumbstick, touchpad finger &amp; LED renders live at 30 Hz." />
          </StackPanel>

          <Border Classes="card">
            <Grid ColumnDefinitions="1.4*,*">
              <local:ControllerDiagram x:Name="TesterControllerDiagram" MaxHeight="300" Margin="0,0,16,0" />
              <StackPanel Grid.Column="1" Spacing="10" VerticalAlignment="Center">
                <TextBlock Classes="hdr" Text="Pressed Controls &amp; Triggers" />
                <Grid ColumnDefinitions="36,*" RowDefinitions="Auto,Auto">
                  <TextBlock Text="L2" VerticalAlignment="Center" Margin="0,0,0,6" />
                  <ProgressBar x:Name="L2Bar" Grid.Column="1" Minimum="0" Maximum="255" Height="12" Margin="0,0,0,6" />
                  <TextBlock Grid.Row="1" Text="R2" VerticalAlignment="Center" />
                  <ProgressBar x:Name="R2Bar" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="255" Height="12" />
                </Grid>
                <TextBlock x:Name="ButtonsActiveTxt" Text="Pressed: (none)" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="RawBytesTxt" Classes="dim" Text="Raw Btn Bytes: --" />
                <Border Height="1" Background="#242B3D" />
                <TextBlock x:Name="TouchTxt" Classes="dim" Text="Touch 0: -- | Touch 1: --" />
                <TextBlock x:Name="GyroTxt" Text="Gyro (X, Y, Z): 0, 0, 0" FontFamily="Consolas" FontSize="12" />
                <TextBlock x:Name="AccelTxt" Text="Accel (X, Y, Z): 0, 0, 0" FontFamily="Consolas" FontSize="12" />
              </StackPanel>
            </Grid>
          </Border>

          <Grid ColumnDefinitions="*,*,*">
            <Border Classes="card" Margin="0,0,7,0">
              <StackPanel Spacing="6" HorizontalAlignment="Center">
                <TextBlock Classes="hdr" Text="Left Stick" HorizontalAlignment="Center" />
                <Canvas Width="120" Height="120" Background="#0F131C">
                  <Ellipse Width="116" Height="116" Canvas.Left="2" Canvas.Top="2" Stroke="#2F3950" StrokeThickness="1.5" />
                  <Ellipse x:Name="LeftStickDot" Width="12" Height="12" Fill="#38BDF8" Canvas.Left="54" Canvas.Top="54" />
                </Canvas>
                <TextBlock x:Name="LeftStickTxt" Classes="dim" Text="128, 128" HorizontalAlignment="Center" />
              </StackPanel>
            </Border>
            <Border Grid.Column="1" Classes="card" Margin="7,0,7,0">
              <StackPanel Spacing="6" HorizontalAlignment="Center">
                <TextBlock Classes="hdr" Text="Right Stick" HorizontalAlignment="Center" />
                <Canvas Width="120" Height="120" Background="#0F131C">
                  <Ellipse Width="116" Height="116" Canvas.Left="2" Canvas.Top="2" Stroke="#2F3950" StrokeThickness="1.5" />
                  <Ellipse x:Name="RightStickDot" Width="12" Height="12" Fill="#A855F7" Canvas.Left="54" Canvas.Top="54" />
                </Canvas>
                <TextBlock x:Name="RightStickTxt" Classes="dim" Text="128, 128" HorizontalAlignment="Center" />
              </StackPanel>
            </Border>
            <Border Grid.Column="2" Classes="card" Margin="7,0,0,0">
              <StackPanel Spacing="6">
                <TextBlock Classes="hdr" Text="Touchpad Monitor" />
                <Canvas Width="230" Height="120" Background="#0F131C" HorizontalAlignment="Left">
                  <Ellipse x:Name="Touch0Dot" Width="13" Height="13" Fill="#22C55E" IsVisible="False" />
                  <Ellipse x:Name="Touch1Dot" Width="13" Height="13" Fill="#F59E0B" IsVisible="False" />
                </Canvas>
                <TextBlock Classes="dim" Text="1920x1080 dual-finger trackpad" />
              </StackPanel>
            </Border>
          </Grid>
        </StackPanel>
      </ScrollViewer>

      <!-- PAGE 2: HAPTICS & RUMBLE -->
      <ScrollViewer x:Name="Page2" IsVisible="False">
        <StackPanel Spacing="14">
          <StackPanel Spacing="2">
            <TextBlock Classes="title" Text="Haptics, Audio &amp; Rumble" />
            <TextBlock Classes="dim" Text="Tune 0x36 audio-haptic waveform gain and test voice-coil haptics, 0x31 classic motors &amp; 0x26 impulse triggers." />
          </StackPanel>

          <Border Classes="card">
            <StackPanel Spacing="12">
              <TextBlock Classes="hdr" Text="Wireless Audio-Haptic Strength (0x36 Stream)" />
              <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="Haptic Gain:" VerticalAlignment="Center" Width="95" />
                <Slider x:Name="HapticGainSlider" Minimum="25" Maximum="255" Value="150" Width="300"
                        ValueChanged="OnHapticGainChanged" />
                <TextBlock x:Name="HapticGainLabel" Text="150%" VerticalAlignment="Center" FontWeight="SemiBold" />
              </StackPanel>
              <Grid ColumnDefinitions="95,*" RowDefinitions="Auto,Auto">
                <TextBlock Text="Game CH3 L:" VerticalAlignment="Center" Margin="0,0,0,8" />
                <ProgressBar x:Name="HapticLBar" Grid.Column="1" Minimum="0" Maximum="100" Height="14" Margin="0,0,0,8" />
                <TextBlock Grid.Row="1" Text="Game CH4 R:" VerticalAlignment="Center" />
                <ProgressBar x:Name="HapticRBar" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="100" Height="14" />
              </Grid>
            </StackPanel>
          </Border>

          <Border Classes="card">
            <StackPanel Spacing="10">
              <TextBlock Classes="hdr" Text="Actuator Function Testers" />
              <WrapPanel Orientation="Horizontal">
                <Button Content="0x36 Crisp Tap (160Hz, 300ms)" Click="OnTestCrispTapClick" Margin="0,0,8,8" />
                <Button Content="0x36 Haptic Buzz (120Hz, 900ms)" Click="OnTestHapticBuzzClick" Margin="0,0,8,8" />
                <Button Content="0x36 Deep Thump (55Hz, 700ms)" Click="OnTestDeepThumpClick" Margin="0,0,8,8" />
                <Button Content="0x31 Classic Rumble Left" Click="OnTestRumbleLeftClick" Margin="0,0,8,8" />
                <Button Content="0x31 Classic Rumble Right" Click="OnTestRumbleRightClick" Margin="0,0,8,8" />
                <Button Content="Impulse Triggers (L2 + R2)" Click="OnTestImpulseTriggersClick" Classes="accent" Margin="0,0,8,8" />
              </WrapPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- PAGE 3: ADAPTIVE TRIGGERS -->
      <ScrollViewer x:Name="Page3" IsVisible="False">
        <StackPanel Spacing="14">
          <StackPanel Spacing="2">
            <TextBlock Classes="title" Text="Adaptive Triggers" />
            <TextBlock Classes="dim" Text="Set custom L2/R2 trigger resistance curves or leave on Follow Game (Auto) for native DualSense &amp; Xbox Impulse Triggers." />
          </StackPanel>

          <Grid ColumnDefinitions="*,*">
            <Border Classes="card" Margin="0,0,7,0">
              <StackPanel Spacing="8">
                <TextBlock Classes="hdr" Text="Left Trigger (L2)" />
                <ComboBox x:Name="LeftTrigCombo" SelectedIndex="0" HorizontalAlignment="Stretch" />
                <TextBlock Text="Start Position (0–255)" Classes="dim" />
                <Slider x:Name="LStartSlider" Minimum="0" Maximum="255" Value="40" />
                <TextBlock Text="End Position (0–255)" Classes="dim" />
                <Slider x:Name="LEndSlider" Minimum="0" Maximum="255" Value="180" />
                <TextBlock Text="Force / Strength (0–255)" Classes="dim" />
                <Slider x:Name="LForceSlider" Minimum="0" Maximum="255" Value="200" />
                <TextBlock Text="Vibration Freq (5–60 Hz)" Classes="dim" />
                <Slider x:Name="LFreqSlider" Minimum="5" Maximum="60" Value="20" />
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
                  <Button Content="Apply L2" Click="OnApplyLeftTriggerClick" Classes="accent" />
                  <Button Content="Follow Game" Click="OnAutoLeftTriggerClick" />
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Grid.Column="1" Classes="card" Margin="7,0,0,0">
              <StackPanel Spacing="8">
                <TextBlock Classes="hdr" Text="Right Trigger (R2)" />
                <ComboBox x:Name="RightTrigCombo" SelectedIndex="0" HorizontalAlignment="Stretch" />
                <TextBlock Text="Start Position (0–255)" Classes="dim" />
                <Slider x:Name="RStartSlider" Minimum="0" Maximum="255" Value="60" />
                <TextBlock Text="End Position (0–255)" Classes="dim" />
                <Slider x:Name="REndSlider" Minimum="0" Maximum="255" Value="170" />
                <TextBlock Text="Force / Strength (0–255)" Classes="dim" />
                <Slider x:Name="RForceSlider" Minimum="0" Maximum="255" Value="220" />
                <TextBlock Text="Vibration Freq (5–60 Hz)" Classes="dim" />
                <Slider x:Name="RFreqSlider" Minimum="5" Maximum="60" Value="25" />
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
                  <Button Content="Apply R2" Click="OnApplyRightTriggerClick" Classes="accent" />
                  <Button Content="Follow Game" Click="OnAutoRightTriggerClick" />
                </StackPanel>
              </StackPanel>
            </Border>
          </Grid>
        </StackPanel>
      </ScrollViewer>

      <!-- PAGE 4: LIGHTING & MIC -->
      <ScrollViewer x:Name="Page4" IsVisible="False">
        <StackPanel Spacing="14">
          <StackPanel Spacing="2">
            <TextBlock Classes="title" Text="Lighting &amp; Microphone" />
            <TextBlock Classes="dim" Text="Customize the DualSense touchpad lightbar glow and bind the physical Mic Mute button to Windows audio." />
          </StackPanel>

          <Border Classes="card">
            <StackPanel Spacing="10">
              <TextBlock Classes="hdr" Text="RGB Lightbar" />
              <StackPanel Orientation="Horizontal" Spacing="14">
                <Border x:Name="LedPreviewBox" Width="56" Height="56" CornerRadius="10" Background="#00A0FF" />
                <StackPanel Spacing="4" Width="340">
                  <Slider x:Name="LedRSlider" Minimum="0" Maximum="255" Value="0" ValueChanged="OnLedSliderChanged" />
                  <Slider x:Name="LedGSlider" Minimum="0" Maximum="255" Value="160" ValueChanged="OnLedSliderChanged" />
                  <Slider x:Name="LedBSlider" Minimum="0" Maximum="255" Value="255" ValueChanged="OnLedSliderChanged" />
                </StackPanel>
              </StackPanel>
              <WrapPanel Orientation="Horizontal">
                <Button Content="Apply RGB" Click="OnApplyLedClick" Classes="accent" Margin="0,0,8,8" />
                <Button Content="Follow Game (Auto)" Click="OnAutoLedClick" Margin="0,0,8,8" />
                <Button Content="Cyan" Click="OnPresetCyanClick" Margin="0,0,8,8" />
                <Button Content="Crimson" Click="OnPresetRedClick" Margin="0,0,8,8" />
                <Button Content="Emerald" Click="OnPresetGreenClick" Margin="0,0,8,8" />
                <Button Content="Purple" Click="OnPresetPurpleClick" Margin="0,0,8,8" />
              </WrapPanel>
            </StackPanel>
          </Border>

          <Border Classes="card">
            <StackPanel Spacing="10">
              <TextBlock Classes="hdr" Text="Microphone Mute &amp; Orange LED" />
              <WrapPanel Orientation="Horizontal">
                <Button Content="Mic LED: OFF" Click="OnMicLedOffClick" Margin="0,0,8,8" />
                <Button Content="Mic LED: Solid ON" Click="OnMicLedSolidClick" Margin="0,0,8,8" />
                <Button Content="Mic LED: Pulse" Click="OnMicLedPulseClick" Margin="0,0,8,8" />
                <Button x:Name="MicMuteTabBtn" Content="Toggle Windows Mic Mute" Click="OnToggleMicMuteClick" Margin="0,0,8,8" />
              </WrapPanel>
              <CheckBox x:Name="SyncMicBtnChk" Content="Sync controller physical Mic Mute button with Windows Mic + LED"
                        IsChecked="True" IsCheckedChanged="OnSyncMicChanged" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- PAGE 5: CONSOLE & UPDATES -->
      <Grid x:Name="Page5" RowDefinitions="Auto,*,Auto" IsVisible="False">
        <StackPanel Spacing="12" Margin="0,0,0,10">
          <StackPanel Spacing="2">
            <TextBlock Classes="title" Text="Console &amp; Updates" />
            <TextBlock Classes="dim" Text="Diagnostics, live Pico CLI console, and 1-click GitHub firmware/app updater." />
          </StackPanel>
          <Border Classes="card">
            <StackPanel Spacing="8">
              <WrapPanel Orientation="Horizontal">
                <Button Content="Status" Click="OnCmdStatusClick" Margin="0,0,8,6" />
                <Button Content="Debug Dump" Click="OnCmdDbgClick" Margin="0,0,8,6" />
                <Button Content="Unlock 0x31 (1)" Click="OnUnlock1Click" Margin="0,0,8,6" />
                <Button Content="Unlock 0x31 (2)" Click="OnUnlock2Click" Margin="0,0,8,6" />
                <Button Content="Unlock 0x31 (3)" Click="OnUnlock3Click" Margin="0,0,8,6" />
                <Button Content="Unlock 0x31 (4)" Click="OnUnlock4Click" Margin="0,0,8,6" />
                <ToggleButton x:Name="BtMonToggle" Content="Input Diff Monitor" Click="OnBtMonToggleClick" Margin="0,0,8,6" />
              </WrapPanel>
              <WrapPanel Orientation="Horizontal">
                <TextBox x:Name="TokenBox" Width="300" Watermark="Optional GitHub Token (Private Repo Updates)" PasswordChar="•" Margin="0,0,8,6" />
                <Button Content="Save Token" Click="OnSaveTokenClick" Margin="0,0,8,6" />
                <Button Content="Update Pico Firmware (.uf2)" Click="OnUpdateFirmwareClick" Background="#16A34A" Foreground="White" Margin="0,0,8,6" />
                <Button Content="Update Desktop App (.exe)" Click="OnUpdateAppClick" Margin="0,0,0,6" />
              </WrapPanel>
              <TextBlock x:Name="UpdaterStatusTxt" Classes="dim" Text="Repo: Yamerooo-hd/SensaDS5Control" />
            </StackPanel>
          </Border>
        </StackPanel>

        <TextBox x:Name="ConsoleLogBox" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True"
                 FontFamily="Consolas" FontSize="12" Background="#090C11" BorderBrush="#212838" TextWrapping="Wrap" Margin="0,0,0,8" />

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
          <TextBox x:Name="CliInputBox" Watermark="Send raw command to Pico (e.g. status, reconnect, imptrig 2 85)..." KeyDown="OnCliKeyDown" Margin="0,0,8,0" />
          <Button Grid.Column="1" Content="Send" Click="OnSendCliClick" Classes="accent" />
        </Grid>
      </Grid>
    </Grid>
  </Grid>
</Window>
